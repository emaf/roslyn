#   "dotnet.projectsystem.cacheInProjectFolder": true

[project]
project=Microsoft.CodeAnalysis.CSharp.Features.csproj
language=C#
lastDtbSucceeded

[properties]
AssemblyName=Microsoft.CodeAnalysis.CSharp.Features
OutputType=Library
ProjectAssetsFile=<PATH>../../../../artifacts/obj/Microsoft.CodeAnalysis.CSharp.Features/project.assets.json
RootNamespace=Microsoft.CodeAnalysis.CSharp

[commandLineArguments]
/noconfig
/unsafe-
/checked-
/fullpaths
/nostdlib+
/errorreport:prompt
/warn:9999
/highentropyva+
/nullable:enable
/debug+
/debug:embedded
/delaysign-
/filealign:512
/keyfile:<NUGET>/microsoft.dotnet.arcade.sdk/10.0.0-beta.26257.4/tools/snk/35MSSharedLib1024.snk
/optimize-
/target:library
/warnaserror-
/utf8output
/deterministic+
/publicsign+
/checksumalgorithm:SHA256
/langversion:preview
/skipanalyzers+
/features:strict
/warnaserror-:IDE0055

